ton_Abort(IN:=n_State=20,PT:=T#30S);
IF ton_Abort.Q AND n_State=20 THEN
    n_State:=21; q_Drain:=FALSE; s_State_Text:='ABORTED';
END_IF
IF n_State=1 AND (NOT b_Permissive_OK OR cmd_Hold) THEN
    n_HoldRes:=n_Phase; n_State:=10; s_State_Text:='HOLDING';
    b_Hold_Active:=TRUE; b_TimerEN:=FALSE;
    q_NaOH:=FALSE; q_AcAc:=FALSE; q_Steam_Enable:=FALSE;
    q_Rinse:=TRUE; q_Pump:=TRUE;
END_IF
CASE n_State OF
0:
    q_Pump:=FALSE; q_NaOH:=FALSE; q_AcAc:=FALSE; q_Rinse:=FALSE;
    q_Drain:=FALSE; q_Steam_Enable:=FALSE; b_Complete:=FALSE;
    b_Running:=FALSE; b_Hold_Active:=FALSE; b_Abort_Active:=FALSE;
    r_Progress:=0.0; n_Phase:=0; r_Temp_SP_Active:=0.0;
    b_TimerEN:=FALSE; s_State_Text:='IDLE';
    IF cmd_Start AND b_Permissive_OK THEN
        n_State:=1; n_Phase:=1; s_State_Text:='RUNNING'; b_Running:=TRUE;
    END_IF
1:
    s_State_Text:='RUNNING'; b_Running:=TRUE;
    IF cmd_Stop THEN
        n_State:=30; b_TimerEN:=FALSE; s_State_Text:='STOPPING'; RETURN;
    END_IF
    ton_Phase(IN:=b_TimerEN,PT:=t_Target);
    r_Elapsed:=DINT_TO_REAL(TIME_TO_DINT(ton_Phase.ET))/1000.0;
    r_TargetS:=DINT_TO_REAL(TIME_TO_DINT(t_Target))/1000.0;
    IF r_TargetS &gt; 0.0 THEN r_Progress:=MIN(100.0,r_Elapsed/r_TargetS*100.0); END_IF
    CASE n_Phase OF
    1:
        q_Rinse:=TRUE; q_Pump:=TRUE; q_Drain:=TRUE;
        q_NaOH:=FALSE; q_AcAc:=FALSE; q_Steam_Enable:=FALSE; r_Temp_SP_Active:=0.0;
        t_Target:=DINT_TO_TIME(REAL_TO_DINT(r_Dur_InitRinse*1000.0));
        IF NOT b_TimerEN THEN b_TimerEN:=TRUE; END_IF
        IF ton_Phase.Q THEN
            b_TimerEN:=FALSE; q_Drain:=FALSE; n_Phase:=2;
            ton_Phase(IN:=FALSE,PT:=t_Target);
        END_IF
    2:
        q_NaOH:=TRUE; q_Pump:=TRUE; q_Steam_Enable:=TRUE;
        q_Rinse:=FALSE; q_AcAc:=FALSE; q_Drain:=FALSE;
        r_Temp_SP_Active:=r_Alk_Temp_SP;
        t_Target:=DINT_TO_TIME(REAL_TO_DINT(r_Dur_AlkWash*1000.0));
        IF NOT b_TimerEN THEN b_TimerEN:=TRUE; END_IF
        IF ton_Phase.Q THEN
            b_TimerEN:=FALSE; q_Steam_Enable:=FALSE; r_Temp_SP_Active:=0.0; n_Phase:=3;
            ton_Phase(IN:=FALSE,PT:=t_Target);
        END_IF
    3:
        q_Rinse:=TRUE; q_Pump:=TRUE; q_Drain:=TRUE;
        q_NaOH:=FALSE; q_AcAc:=FALSE; q_Steam_Enable:=FALSE; r_Temp_SP_Active:=0.0;
        t_Target:=DINT_TO_TIME(REAL_TO_DINT(r_Dur_InterRinse*1000.0));
        IF NOT b_TimerEN THEN b_TimerEN:=TRUE; END_IF
        IF ton_Phase.Q THEN
            b_TimerEN:=FALSE; q_Drain:=FALSE; n_Phase:=4;
            ton_Phase(IN:=FALSE,PT:=t_Target);
        END_IF
    4:
        q_AcAc:=TRUE; q_Pump:=TRUE; q_Steam_Enable:=TRUE;
        q_Rinse:=FALSE; q_NaOH:=FALSE; q_Drain:=FALSE;
        r_Temp_SP_Active:=r_Acid_Temp_SP;
        t_Target:=DINT_TO_TIME(REAL_TO_DINT(r_Dur_AcidWash*1000.0));
        IF NOT b_TimerEN THEN b_TimerEN:=TRUE; END_IF
        IF ton_Phase.Q THEN
            b_TimerEN:=FALSE; q_Steam_Enable:=FALSE; r_Temp_SP_Active:=0.0; n_Phase:=5;
            ton_Phase(IN:=FALSE,PT:=t_Target);
        END_IF
    5:
        q_Rinse:=TRUE; q_Pump:=TRUE; q_Drain:=TRUE;
        q_AcAc:=FALSE; q_Steam_Enable:=FALSE; r_Temp_SP_Active:=0.0;
        t_Target:=DINT_TO_TIME(REAL_TO_DINT(r_Dur_FinalRinse*1000.0));
        IF NOT b_TimerEN THEN b_TimerEN:=TRUE; END_IF
        IF ton_Phase.Q THEN
            b_TimerEN:=FALSE; ton_Phase(IN:=FALSE,PT:=t_Target);
            IF r_Cond_PV &lt;= r_Cond_Baseline THEN
                n_State:=5; n_Phase:=0; b_Complete:=TRUE; b_Running:=FALSE;
                r_Progress:=100.0; s_State_Text:='COMPLETE';
            ELSE
                b_Alarm_Rinse_Fail:=TRUE; n_State:=20;
                b_Abort_Active:=TRUE; s_State_Text:='ABORTING';
            END_IF
        END_IF
    END_CASE
5:
    s_State_Text:='COMPLETE'; b_Complete:=TRUE; b_Running:=FALSE;
    q_Pump:=FALSE; q_Rinse:=FALSE; q_Drain:=FALSE;
    IF cmd_Reset THEN
        n_State:=0; b_Complete:=FALSE; r_NaOH_Vol:=0.0; r_AcAc_Vol:=0.0;
        b_Alarm_Rinse_Fail:=FALSE; s_State_Text:='IDLE';
    END_IF
10:
    s_State_Text:='HOLDING'; q_Pump:=TRUE; q_Rinse:=TRUE;
    q_NaOH:=FALSE; q_AcAc:=FALSE; q_Steam_Enable:=FALSE;
    ton_Hold(IN:=TRUE,PT:=T#5S);
    IF ton_Hold.Q THEN n_State:=11; s_State_Text:='HELD'; END_IF
11:
    s_State_Text:='HELD'; q_Pump:=TRUE; q_Rinse:=TRUE;
    IF cmd_Restart AND b_Permissive_OK THEN
        n_State:=12; s_State_Text:='RESTARTING';
        b_Hold_Active:=FALSE; ton_Hold(IN:=FALSE,PT:=T#5S);
    END_IF
12:
    s_State_Text:='RESTARTING'; ton_Hold(IN:=TRUE,PT:=T#5S);
    IF ton_Hold.Q AND b_Permissive_OK THEN
        n_Phase:=n_HoldRes; n_State:=1; s_State_Text:='RUNNING'; b_TimerEN:=FALSE;
    END_IF
20:
    s_State_Text:='ABORTING'; q_NaOH:=FALSE; q_AcAc:=FALSE;
    q_Steam_Enable:=FALSE; q_Pump:=TRUE; q_Rinse:=TRUE; q_Drain:=TRUE;
21:
    s_State_Text:='ABORTED'; q_Pump:=FALSE; q_Rinse:=FALSE; q_Drain:=FALSE;
    IF cmd_Reset THEN
        b_Abort_Active:=FALSE; b_Alarm_Rinse_Fail:=FALSE;
        n_State:=0; s_State_Text:='IDLE';
    END_IF
30:
    s_State_Text:='STOPPING'; q_NaOH:=FALSE; q_AcAc:=FALSE;
    q_Steam_Enable:=FALSE; q_Pump:=TRUE; q_Rinse:=TRUE;
    ton_Hold(IN:=TRUE,PT:=T#30S);
    IF ton_Hold.Q THEN
        q_Pump:=FALSE; q_Rinse:=FALSE; n_State:=31; s_State_Text:='STOPPED';
    END_IF
31:
    s_State_Text:='STOPPED'; b_Running:=FALSE;
    IF cmd_Reset THEN n_State:=0; s_State_Text:='IDLE'; END_IF
ELSE
    GVL_Alarms.b_EStop_Active:=TRUE;
END_CASE</xhtml:p>
          </ST>
        </body>
