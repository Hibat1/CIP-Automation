      <pou name="FB_PID_Industrial" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="r_SP">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_PV">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="b_Auto">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="r_Manual_Out">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_Kp">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="3.5" />
              </initialValue>
            </variable>
            <variable name="r_Ti">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="12.5" />
              </initialValue>
            </variable>
            <variable name="r_Td">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="6.25" />
              </initialValue>
            </variable>
            <variable name="r_Tf">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.5" />
              </initialValue>
            </variable>
            <variable name="r_Dt">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.02" />
              </initialValue>
            </variable>
            <variable name="r_OutMin">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.0" />
              </initialValue>
            </variable>
            <variable name="r_OutMax">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="100.0" />
              </initialValue>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="r_Output">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_Error">
              <type>
                <REAL />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="r_Integral">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_D_Filt">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_PrevPV">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_Raw_Out">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_BackCalc">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_Ki">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_Kb">
              <type>
                <REAL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p>IF NOT b_Auto THEN
    r_Output   := MAX(r_OutMin, MIN(r_OutMax, r_Manual_Out));
    r_Integral := r_Output;
    r_PrevPV   := r_PV;
    r_D_Filt   := 0.0;
    RETURN;
END_IF
r_Ki := (1.0 / r_Ti) * r_Dt;
r_Kb := r_Dt / r_Ti;
r_Error   := r_SP - r_PV;
r_Integral := r_Integral + r_Kp * r_Ki * r_Error + r_BackCalc;
r_D_Filt   := (r_Td * (r_PrevPV - r_PV) / r_Dt + r_D_Filt * r_Tf) / (r_Tf + r_Dt);
r_Raw_Out  := r_Kp * r_Error + r_Integral + r_Kp * r_D_Filt;
IF r_Raw_Out &gt; r_OutMax THEN
    r_Output := r_OutMax;
ELSIF r_Raw_Out &lt; r_OutMin THEN
    r_Output := r_OutMin;
ELSE
    r_Output := r_Raw_Out;
END_IF
r_BackCalc := r_Kb * (r_Output - r_Raw_Out);
r_PrevPV   := r_PV;</xhtml:p>
          </ST>
        </body>
      </pou>
      <pou name="FB_SafetyManager" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="r_Temp_PV">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_Pressure_PV">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_Flow_PV">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="b_EStop_NC">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_Pump_Cmd">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_Pump_RunFB">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_Pump_OL_OK">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_AI_Temp_Fault">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_AI_Pres_Fault">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_SafetyReset">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="r_Temp_TripSP">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="60.0" />
              </initialValue>
            </variable>
            <variable name="r_Pres_TripSP">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="6.0" />
              </initialValue>
            </variable>
            <variable name="t_PumpTimeout">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="T#3S" />
              </initialValue>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="b_EStop_Active">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_Alarm_HighTemp">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_Alarm_HighPres">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_Alarm_LowFlow">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_Alarm_PumpFault">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_Alarm_AI_Fault">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="q_SafeState_Drain">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="n_Active">
              <type>
                <INT />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="ton_Pump">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="n_Count">
              <type>
                <INT />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p>n_Count := 0;
IF r_Temp_PV &gt;= r_Temp_TripSP OR b_AI_Temp_Fault THEN
    b_Alarm_HighTemp := TRUE;
    n_Count := n_Count + 1;
END_IF
IF r_Pressure_PV &gt;= r_Pres_TripSP OR b_AI_Pres_Fault THEN
    b_Alarm_HighPres := TRUE;
    n_Count := n_Count + 1;
END_IF
ton_Pump(IN := b_Pump_Cmd AND NOT b_Pump_RunFB, PT := t_PumpTimeout);
IF ton_Pump.Q THEN
    b_Alarm_PumpFault := TRUE;
    n_Count := n_Count + 1;
END_IF
IF NOT b_EStop_NC THEN n_Count := n_Count + 1; END_IF
IF NOT b_Pump_OL_OK THEN n_Count := n_Count + 1; END_IF
b_Alarm_AI_Fault := b_AI_Temp_Fault OR b_AI_Pres_Fault;
n_Active := n_Count;
IF n_Count &gt; 0 THEN
    b_EStop_Active    := TRUE;
    q_SafeState_Drain := TRUE;
END_IF
IF b_SafetyReset AND NOT b_Alarm_HighTemp AND NOT b_Alarm_HighPres
   AND NOT b_Alarm_PumpFault AND b_EStop_NC AND b_Pump_OL_OK THEN
    b_EStop_Active    := FALSE;
    b_Alarm_HighTemp  := FALSE;
    b_Alarm_HighPres  := FALSE;
    b_Alarm_PumpFault := FALSE;
    b_Alarm_LowFlow   := FALSE;
    q_SafeState_Drain := FALSE;
    n_Active          := 0;
END_IF</xhtml:p>
          </ST>
        </body>
      </pou>
