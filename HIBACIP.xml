      <pou name="FB_SensorDiag" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="w_RawAI">
              <type>
                <WORD />
              </type>
            </variable>
            <variable name="r_EU_Lo">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_EU_Hi">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_Filter_Alpha">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.15" />
              </initialValue>
            </variable>
            <variable name="r_WB_Threshold">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="1000.0" />
              </initialValue>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="r_ScaledPV">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_FilteredPV">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="b_WireFault">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="b_BadQuality">
              <type>
                <BOOL />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="r_Raw">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="r_PrevFilt">
              <type>
                <REAL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p>r_Raw := WORD_TO_REAL(w_RawAI);
IF r_Raw &lt; r_WB_Threshold THEN
    b_WireFault  := TRUE;
    b_BadQuality := TRUE;
    r_ScaledPV   := -999.0;
    r_FilteredPV := -999.0;
    RETURN;
END_IF
b_WireFault := FALSE;
r_ScaledPV  := (r_Raw / 32767.0) * (r_EU_Hi - r_EU_Lo) + r_EU_Lo;
IF r_ScaledPV &gt; r_EU_Hi THEN r_ScaledPV := r_EU_Hi; END_IF
IF r_ScaledPV &lt; r_EU_Lo THEN r_ScaledPV := r_EU_Lo; END_IF
r_FilteredPV := r_Filter_Alpha * r_ScaledPV
    + (1.0 - r_Filter_Alpha) * r_PrevFilt;
r_PrevFilt   := r_FilteredPV;
b_BadQuality := b_WireFault;</xhtml:p>
          </ST>
        </body>
      </pou>
